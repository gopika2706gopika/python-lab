#tuple
a=[1,4,7,1,5]
print(a.index(5))
print(a.count(5))
print(len(a))
print(min(a))
print(max(a))

#set
a={1,5,2,3,6,5}
print(a)

x={1,2,3,4}
y={3,4,5,6}
print(x.union(y))
print(x.intersection(y))
print(x.symmetric_difference(y))
print(x.difference(y))
print(y.difference(x))

#issuperset and issubset
i={1,2,3}
j={1,2}
print(i.issuperset(j))
print(i.issubset(j))
print(i.isdisjoint(j))
print(j.isdisjoint(i))
print(j.issuperset(i))
print(j.issubset(i))    


